{
  "name": "mediqliq-abdm-master-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Dedicated MediQliq ABDM master/control-plane backend for M1, M2 and M3 orchestration",
  "main": "server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "validate": "node scripts/validate-config.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.js",
    "consent-validator:test": "node --test apps/consent-validator/tests/*.test.js",
    "consent-validator:start": "node apps/consent-validator/server.js",
    "plans:seed": "node scripts/seed-default-plans.js",
    "migrate:full-access-hospital": "node scripts/migrate-existing-hospital-full-access.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.4",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
