# Dedicated master process only. Never commit a real .env file.
NODE_ENV=development
APP_ROLE=ABDM_MASTER
PORT=5004
MONGO_URI=<SET_YOUR_CURRENT_MONGO_URI_HERE>
JWT_SECRET=<GENERATE_WITH_OPENSSL_RAND_BASE64_48>
CORS_ORIGINS=http://localhost:5173,https://admin.mediqliq.com
TRUST_PROXY_HOPS=1

# ABDM gateway identity - master only
ABDM_ENV=sandbox
ABDM_CLIENT_ID=<ROTATED_SANDBOX_CLIENT_ID>
ABDM_CLIENT_SECRET=<ROTATED_SANDBOX_CLIENT_SECRET>
ABDM_BRIDGE_ID=<BRIDGE_ID>
ABDM_CM_ID=sbx
ABDM_SESSION_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3/sessions
ABDM_HIECM_BASE_URL=https://dev.abdm.gov.in/api/hiecm
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
ABDM_PUBLIC_BASE_URL=https://api.mediqliq.com

ABDM_MASTER_ADMIN_KEY=<GENERATE_WITH_OPENSSL_RAND_BASE64_48>
# Accepts 64 hex chars or a strong passphrase; 64 hex is recommended.
ABDM_MASTER_ENCRYPTION_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

ABDM_ENABLE_M1=true
ABDM_ENABLE_M2=true
ABDM_ENABLE_M3=true
ABDM_ENABLE_SUBSCRIPTIONS=false

# Official HFR/HSP bridge-service registration. Sandbox default follows the
# supplied February 2026 V3 collection. The gateway session token is used
# automatically unless a dedicated token is provided.
ABDM_FACILITY_REGISTRATION_URL=https://apihspsbx.abdm.gov.in/v4/int/v1/bridges/MutipleHRPAddUpdateServices
ABDM_FACILITY_REGISTRATION_ALLOWED_HOSTS=apihspsbx.abdm.gov.in
ABDM_FACILITY_REGISTRATION_TOKEN=

ABDM_VERIFY_CALLBACK_JWT=true
ABDM_OPENID_CONFIGURATION_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3/.well-known/openid-configuration
ABDM_CALLBACK_EXPECTED_ISSUER=
ABDM_CALLBACK_EXPECTED_AUDIENCE=
ABDM_CALLBACK_REQUIRED_CLAIMS=
ABDM_CALLBACK_ALLOWED_IPS=
ABDM_STORE_CALLBACK_PAYLOADS=false
ABDM_CALLBACK_RATE_LIMIT_PER_MINUTE=3000
ABDM_CALLBACK_BODY_LIMIT=25mb

ABDM_CONNECTOR_TIMEOUT_MS=15000
# Strongly recommended in production: comma-separated exact hospital API hostnames.
ABDM_CONNECTOR_ALLOWED_HOSTS=
ABDM_ALLOW_PRIVATE_CONNECTOR_URLS=false
ABDM_INTERNAL_REQUEST_MAX_AGE_MS=300000
ABDM_INTERNAL_REPLAY_TTL_SECONDS=600
ABDM_JOB_POLL_INTERVAL_MS=1000
ABDM_JOB_BATCH_SIZE=5
ABDM_JOB_MAX_ATTEMPTS=5
ABDM_JOB_RETENTION_DAYS=30

# Master may relay already-encrypted HIP payloads. It does not decrypt clinical data.
ABDM_DATA_PUSH_MODE=disabled
ABDM_DATA_PUSH_ALLOWED_HOSTS=
ABDM_CRYPTO_ADAPTER_URL=
ABDM_CRYPTO_ADAPTER_ALLOWED_HOSTS=

# One-time super-admin bootstrap
MEDIQLIQ_BOOTSTRAP_SECRET=<GENERATE_WITH_OPENSSL_RAND_BASE64_48>
