# Dedicated master process only. Never commit a real .env file.
NODE_ENV=development
APP_ROLE=ABDM_MASTER
PORT=5004
MONGO_URI=<SET_YOUR_CURRENT_MONGO_URI_HERE>
JWT_SECRET=<GENERATE_WITH_OPENSSL_RAND_BASE64_48>
CORS_ORIGINS=http://localhost:5173,https://admin.mediqliq.com
TRUST_PROXY_HOPS=1

# ABDM gateway identity - master only
ABDM_ENV=sandbox
ABDM_CLIENT_ID=<ROTATED_SANDBOX_CLIENT_ID>
ABDM_CLIENT_SECRET=<ROTATED_SANDBOX_CLIENT_SECRET>
ABDM_BRIDGE_ID=<BRIDGE_ID>
ABDM_CM_ID=sbx
ABDM_SESSION_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3/sessions
ABDM_HIECM_BASE_URL=https://dev.abdm.gov.in/api/hiecm
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
ABDM_PUBLIC_BASE_URL=https://api.mediqliq.com

ABDM_MASTER_ADMIN_KEY=<GENERATE_WITH_OPENSSL_RAND_BASE64_48>
# Accepts 64 hex chars or a strong passphrase; 64 hex is recommended.
ABDM_MASTER_ENCRYPTION_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

ABDM_ENABLE_M1=true
ABDM_ENABLE_M2=true
ABDM_ENABLE_M3=true
ABDM_ENABLE_SUBSCRIPTIONS=false

# Official HFR/HSP bridge-service registration. Sandbox default follows the
# supplied February 2026 V3 collection. The gateway session token is used
# automatically unless a dedicated token is provided.
ABDM_FACILITY_REGISTRATION_URL=https://apihspsbx.abdm.gov.in/v4/int/v1/bridges/MutipleHRPAddUpdateServices
ABDM_FACILITY_REGISTRATION_ALLOWED_HOSTS=apihspsbx.abdm.gov.in
ABDM_FACILITY_REGISTRATION_TOKEN=

ABDM_VERIFY_CALLBACK_JWT=true
ABDM_OPENID_CONFIGURATION_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3/.well-known/openid-configuration
ABDM_CALLBACK_EXPECTED_ISSUER=
ABDM_CALLBACK_EXPECTED_AUDIENCE=
ABDM_CALLBACK_REQUIRED_CLAIMS=
ABDM_CALLBACK_ALLOWED_IPS=
ABDM_STORE_CALLBACK_PAYLOADS=false
ABDM_CALLBACK_RATE_LIMIT_PER_MINUTE=3000
ABDM_CALLBACK_BODY_LIMIT=25mb

ABDM_CONNECTOR_TIMEOUT_MS=15000
# Strongly recommended in production: comma-separated exact hospital API hostnames.
ABDM_CONNECTOR_ALLOWED_HOSTS=
ABDM_ALLOW_PRIVATE_CONNECTOR_URLS=false
ABDM_INTERNAL_REQUEST_MAX_AGE_MS=300000
ABDM_INTERNAL_REPLAY_TTL_SECONDS=600
ABDM_DEPENDENCY_STATUS_TTL_SECONDS=300
ABDM_JOB_POLL_INTERVAL_MS=1000
ABDM_JOB_BATCH_SIZE=5
ABDM_JOB_MAX_ATTEMPTS=5
ABDM_JOB_RETENTION_DAYS=30

# Master HIP data-push orchestration uses the same private crypto adapter configured below.
ABDM_DATA_PUSH_MODE=disabled
ABDM_DATA_PUSH_ALLOWED_HOSTS=

# One-time super-admin bootstrap
MEDIQLIQ_BOOTSTRAP_SECRET=<GENERATE_WITH_OPENSSL_RAND_BASE64_48>

# ---------------------------------------------------------------------------
# Shared ABDM compute platform (hospital -> Master -> private service network)
# ---------------------------------------------------------------------------
# Hospital backends NEVER call these private URLs directly in the centralized
# deployment. They authenticate to /internal/abdm/shared/* with their existing
# connector HMAC credentials; Master derives tenant/facility identity from that
# authentication and forwards it to the private service as trusted headers.
ABDM_SHARED_SERVICES_REQUIRE_HTTPS=false
ABDM_SHARED_SERVICE_RATE_LIMIT_PER_MINUTE=300
ABDM_SHARED_FHIR_RATE_LIMIT_PER_MINUTE=180
ABDM_SHARED_CRYPTO_RATE_LIMIT_PER_MINUTE=180
ABDM_SHARED_CONSENT_RATE_LIMIT_PER_MINUTE=300
ABDM_SHARED_HEALTH_RATE_LIMIT_PER_MINUTE=60

# NRCeS/HAPI FHIR validator service. Keep it on the Master private network.
# Containerized Master API on mediqliq-abdm-internal: use the service DNS below.
# Host-process Master API: use http://127.0.0.1:3500/validate instead.
ABDM_FHIR_VALIDATOR_URL=http://mediqliq-fhir-validator:3500/validate
ABDM_FHIR_VALIDATOR_HEALTH_URL=http://mediqliq-fhir-validator:3500/validator/version
ABDM_FHIR_VALIDATOR_ALLOWED_HOSTS=mediqliq-fhir-validator
ABDM_FHIR_VALIDATOR_TOKEN=<PRIVATE_SERVICE_TOKEN>
ABDM_FHIR_VALIDATOR_TIMEOUT_MS=30000
ABDM_FHIR_VALIDATOR_MAX_REQUEST_BYTES=26214400
ABDM_FHIR_VALIDATOR_MAX_RESPONSE_BYTES=1048576

# Validated ABDM crypto adapter. Production receiver-key operations MUST return
# an opaque keyHandle; private key material is rejected by the Master facade.
# Host-process alternative: http://127.0.0.1:8090
ABDM_CRYPTO_ADAPTER_URL=http://mediqliq-crypto-adapter:8090
ABDM_CRYPTO_ADAPTER_HEALTH_URL=http://mediqliq-crypto-adapter:8090/health
ABDM_CRYPTO_ADAPTER_ALLOWED_HOSTS=mediqliq-crypto-adapter
ABDM_CRYPTO_ADAPTER_TOKEN=<PRIVATE_SERVICE_TOKEN>
# Used only by the private crypto container; store in KMS/Secrets Manager.
ABDM_CRYPTO_KEY_HANDLE_SECRET_BASE64=<32_RANDOM_BYTES_BASE64>
ABDM_CRYPTO_KEY_HANDLE_VERSION=v1
ABDM_CRYPTO_KEY_TTL_SECONDS=1800
ABDM_CRYPTO_ADAPTER_TIMEOUT_MS=30000
ABDM_CRYPTO_ADAPTER_MAX_REQUEST_BYTES=26214400
ABDM_CRYPTO_ADAPTER_MAX_RESPONSE_BYTES=26214400
ABDM_REQUIRE_CRYPTO_INTEGRITY=true

# Cryptographic consent validator + durable usage ledger. The private validator
# must scope its ledger by X-MediQliq-Tenant-Code/X-MediQliq-Facility-ID.
# Host-process alternative: http://127.0.0.1:8180/v1/validate
ABDM_CONSENT_VALIDATOR_URL=http://mediqliq-consent-validator:8180/v1/validate
ABDM_CONSENT_VALIDATOR_HEALTH_URL=http://mediqliq-consent-validator:8180/health/ready
ABDM_CONSENT_VALIDATOR_ALLOWED_HOSTS=mediqliq-consent-validator
ABDM_CONSENT_VALIDATOR_TOKEN=<PRIVATE_SERVICE_TOKEN>
# Private consent-validator runtime. Prefer a dedicated replica-set database and pinned approved JWKS.
ABDM_CONSENT_VALIDATOR_MONGO_URI=<PRIVATE_MONGODB_URI>
ABDM_CONSENT_VALIDATOR_IDENTIFIER_PEPPER=<RANDOM_HASH_PEPPER>
ABDM_CONSENT_VALIDATOR_JWKS_URL=
ABDM_CONSENT_VALIDATOR_JWKS_ALLOWED_HOSTS=
ABDM_CONSENT_VALIDATOR_PINNED_JWKS_JSON={"keys":[]}
ABDM_CONSENT_VALIDATOR_EXPECTED_ISSUERS=<APPROVED_ISSUER>
ABDM_CONSENT_VALIDATOR_EXPECTED_AUDIENCES=<MEDIQLIQ_ABDM_AUDIENCE>
ABDM_CONSENT_VALIDATOR_ALLOWED_ALGORITHMS=RS256,RS512,ES256
ABDM_CONSENT_VALIDATOR_TIMEOUT_MS=15000
ABDM_CONSENT_VALIDATOR_MAX_REQUEST_BYTES=2097152
ABDM_CONSENT_VALIDATOR_MAX_RESPONSE_BYTES=1048576
ABDM_CONSENT_RESERVATION_TTL_SECONDS=86400
ABDM_CONSENT_RESERVATION_STALE_LOCK_MS=120000
